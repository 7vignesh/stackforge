# StackForge API Environment Variables
# IMPORTANT: Never commit real API keys. Copy this file to .env and fill in your values.

PORT=3001
NODE_ENV=development

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Provider selection: auto | openrouter | mock
STACKFORGE_PROVIDER=auto

# Codegen provider: default | nvidia
STACKFORGE_CODEGEN_PROVIDER=default

# OpenRouter API Keys (all 3 required for key rotation)
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_APP_NAME=stackforge-api
OPENROUTER_APP_URL=http://localhost:3001

# NVIDIA API Keys (all 3 required for key rotation)
NVIDIA_API_KEY=
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_CODEGEN_MODEL=moonshotai/kimi-k2.5
NVIDIA_APP_NAME=stackforge-codegen
NVIDIA_APP_URL=http://localhost:3001
